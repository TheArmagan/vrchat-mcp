# vrchat-mcp configuration
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Every variable below is read by `src/config.ts` and nowhere else.
# Boolean flags accept `1` or `true` (case-insensitive); anything else is off.
# VRCHAT_MCP_RPS / _MAX_WAIT_MS / _2FA_TIMEOUT_MS must parse as a positive
# integer or the default applies; the retention vars accept 0 as well.

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# Login is lazy: nothing authenticates at startup and `tools/list` works with
# none of these set. A missing username/password surfaces as a tool error on
# the first call that needs the API, not as a startup crash.

# VRChat account name (not the display name). No default.
VRCHAT_USERNAME=your-vrchat-username

# VRChat account password. No default.
VRCHAT_PASSWORD=your-vrchat-password

# Base32 TOTP secret from your authenticator app. Optional.
# Set it for fully unattended login. Leave it unset if the account uses email
# OTP, or if you would rather approve each login by hand — then the server
# pauses the call and asks for the code via `vrchat_submitTwoFactorCode`.
# VRCHAT_TOTP_SECRET=your-base32-totp-secret

# REQUIRED IN PRACTICE. Goes into the descriptive User-Agent VRChat demands;
# generic agents get 403'd. Use an email address or a project URL you own.
# Must be REAL: the SDK explicitly refuses any contact containing @example.com,
# so the obvious placeholder is the one value guaranteed to fail.
VRCHAT_CONTACT=your-real-email@your-domain.tld

# ---------------------------------------------------------------------------
# Tool surface
# ---------------------------------------------------------------------------

# Comma-separated OpenAPI tags to register. Unset (default) = every tag,
# ~250 tools. Values are trimmed, lowercased and de-duped.
# VRCHAT_MCP_TAGS=economy,inventory,users

# ---------------------------------------------------------------------------
# Safety gates — all default to off, i.e. the server is read-only
# ---------------------------------------------------------------------------

# Registers `write` and `destructive` operations (POST/PUT/PATCH/DELETE).
# Default: off.
# VRCHAT_MCP_ALLOW_WRITES=1

# Additionally registers `money` operations (purchases, product listings,
# Tilia/KYC/payout paths). Requires VRCHAT_MCP_ALLOW_WRITES as well.
# Default: off.
# VRCHAT_MCP_ALLOW_PURCHASES=1

# Registers `admin` operations (account lifecycle, moderation, asset review —
# includes `deleteUser`). Independent of the write gate. Default: off.
# VRCHAT_MCP_ALLOW_ADMIN=1

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Sustained outbound requests per second through the shared token bucket.
# Default: 20. Lower it if VRChat starts complaining.
# VRCHAT_MCP_RPS=20

# How long a single call may sit queued behind the limiter before returning a
# "rate limited locally, retry" result instead of hanging. Milliseconds.
# Default: 30000.
# VRCHAT_MCP_MAX_WAIT_MS=30000

# ---------------------------------------------------------------------------
# WebSocket event pipeline
# ---------------------------------------------------------------------------

# Opens the VRChat pipeline socket and registers the `vrchat_events*` tools.
# Default: off — an idle socket burns a session slot.
# VRCHAT_MCP_WEBSOCKET=1

# Comma-separated event types to subscribe to. This REPLACES the default set
# rather than adding to it. Default: notification, notification-v2,
# economy-update, friend-online, friend-offline, instance-queue-ready.
# VRCHAT_MCP_WS_EVENTS=notification,notification-v2,economy-update,friend-online,friend-offline,instance-queue-ready

# Retained events PER EVENT TYPE, not in total. First bare number is the
# default for every type; `type:value` entries override it for that type only.
# Default: 1000.
# VRCHAT_MCP_HISTORY=1000,friend-location:200,economy-update:5000

# Age ceiling on retained events, applied alongside the count cap — whichever
# limit bites first wins. Accepts `30d`, `12h`, `90m`, `45s`, `500ms`, a bare
# millisecond count, or `0` to disable the age sweep. Same per-type override
# syntax as VRCHAT_MCP_HISTORY. Default: 30d.
# VRCHAT_MCP_HISTORY_MAX_AGE=30d,friend-location:2h

# ---------------------------------------------------------------------------
# Local data files
# ---------------------------------------------------------------------------
# Both default to `<project root>/.vrchat-mcp/`, where the project root is found
# by walking up from the working directory for a .git / package.json / deno.json
# / pyproject.toml / go.mod marker. State is therefore PER PROJECT, and each
# project logs in separately. The directory self-ignores (it gets a .gitignore
# containing `*` on creation), so the session is never committed by accident.
# A relative value below is resolved against the working directory.

# SQLite event-history database. Default: <project root>/.vrchat-mcp/events.db
# VRCHAT_MCP_DB=.vrchat-mcp/events.db

# Persisted auth session. THIS FILE IS A CREDENTIAL — treat it like a password.
# Default: <project root>/.vrchat-mcp/session.json
# Point every install at one absolute path to share a single login (and skip
# re-doing 2FA) across projects.
# VRCHAT_MCP_SESSION=.vrchat-mcp/session.json

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Proxy for BOTH API and WebSocket traffic. `http://` or `https://`, with
# optional `user:pass@` credentials. Unset = direct.
# SOCKS is NOT supported: Bun's fetch rejects socks5:// outright, so such a URL
# fails at startup with a clear error instead of half-working. Front a SOCKS
# proxy with a local HTTP proxy and point this at that.
# A failed proxy is a hard error — the server never silently falls back to a
# direct connection. Never logged.
# VRCHAT_MCP_PROXY=http://user:pass@127.0.0.1:8080

# ---------------------------------------------------------------------------
# Two-factor prompt
# ---------------------------------------------------------------------------

# How long a paused login waits for `vrchat_submitTwoFactorCode` before the
# request expires and must be retried. Milliseconds. Default: 300000 (5 min).
# VRCHAT_MCP_2FA_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------

# Opts into the live integration suite (`bun run test:live`), which makes real
# API calls with the credentials above. Default: off, so `bun test` never needs
# credentials. Reads and creator-owned writes only — never money or admin ops.
# VRCHAT_LIVE_TESTS=1
